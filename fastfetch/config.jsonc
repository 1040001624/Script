{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
"display": {
  "separator": " : ",
  "key": {
    "width": 12
  }
},
  "logo": {
    "type": "none"
  },
  "modules": [
  {
      "type": "separator"
    },
    {
      "type": "title",
      "key": "主机"
    },
    {
      "type": "os",
      "key": "系统"
    },
    {
      "type": "kernel",
      "key": "内核"
    },
    {
      "type": "host",
      "key": "设备"
    },
    {
      "type": "cpu",
      "key": "处理器"
    },
    {
      "type": "packages",
      "key": "软件包"
    },
    {
      "type": "shell",
      "key": "Shell"
    },
    {
      "type": "terminal",
      "key": "终端"
    },
    {
      "type": "gpu",
      "key": "显卡"
    },
    {
  "type": "command",
  "key": "架构",
  "text": "echo \"$(uname -m) / $(nproc)核 / $(lscpu | awk -F: '/Model name/{print $2}' | grep -oE '[0-9.]+GHz' | head -1)\""
},
{
      "type": "locale",
      "key": "语言"
     },
  {
      "type": "separator"
    },
    {
  "type": "command",
  "key": "CPU占用",
  "text": "top -bn1 | grep 'Cpu(s)' | awk '{print 100-$8\"%\"}'"
},
{
  "type": "command",
  "key": "系统负载",
  "text": "uptime | awk -F'load average:' '{print $2}'"
},
{
  "type": "command",
  "key": "TCP/UDP",
  "text": "echo TCP:$(ss -ant | grep ESTAB | wc -l) UDP:$(ss -anu | wc -l)"
},
 {
      "type": "memory",
      "key": "物理内存"
    },
    {
      "type": "swap",
      "key": "虚拟内存"
    },
    {
      "type": "disk",
      "key": "磁盘占用"
    },
    {
      "type": "separator"
    },
    {
  "type": "command",
  "key": "网络算法",
  "text": "echo \"$(sysctl -n net.ipv4.tcp_congestion_control) ($(uname -r))\""
},
    {
  "type": "command",
  "key": "运营商",
  "text": "curl -s ipinfo.io/org"
},
    {
      "type": "localip",
      "key": "内网IP4",
      "showIpv4": true
    },
     {
      "type": "localip",
      "key": "内网IP6",
      "showIpv4": false,
      "showIpv6": true
    },
    {
  "type": "command",
  "key": "DNS IPv4",
  "text": "cat /etc/resolv.conf | grep nameserver | awk '{print $2}' | grep -v ':' | paste -sd ','"
},
{
  "type": "command",
  "key": "DNS IPv6",
  "text": "cat /etc/resolv.conf | grep nameserver | awk '{print $2}' | grep ':' | paste -sd ','"
},
{
  "type": "command",
  "key": "SSH登录",
  "text": "CFG=$(cat /etc/ssh/sshd_config /etc/ssh/sshd_config.d/*.conf 2>/dev/null); if echo \"$CFG\" | grep -Eq '^AuthenticationMethods[[:space:]]+publickey,password'; then echo '密钥登录+密码登录'; elif echo \"$CFG\" | grep -Eq '^PasswordAuthentication[[:space:]]+no' && echo \"$CFG\" | grep -Eq '^PubkeyAuthentication[[:space:]]+yes'; then echo '密钥登录'; elif echo \"$CFG\" | grep -Eq '^PasswordAuthentication[[:space:]]+yes'; then echo '密码登录'; else echo '默认'; fi"
},
{
  "type": "command",
  "key": "运行时间",
  "text": "awk '{d=int($1/86400); h=int(($1%86400)/3600); m=int(($1%3600)/60); printf \"%d天 %d小时 %d分\",d,h,m}' /proc/uptime"
},
{
      "type": "break"
    },
    {
      "type": "colors"
    }
  ]
}
